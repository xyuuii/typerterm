    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "start": "npm run build && npm run bridge",
    "test": "node --test tests/*.test.mjs bridge/bridge.test.mjs",
    "fixture": "node scripts/dev-ssh-fixture.mjs"
  },
  "dependencies": {
    "@fontsource/courier-prime": "5.3.0",
